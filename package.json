{
    "name": "BNotes",
    "version": "1.4.0",
    "description": "读书笔记管理系统",
    "author": "BNotes",
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite",
        "dev:server": "node backend-node/server.js",
        "dev:all": "concurrently \"npm run dev\" \"npm run dev:server\"",
        "build": "vite build",
        "preview": "vite preview",
        "electron": "electron .",
        "dist": "npm run build && electron-builder --win --x64"
    },
    "dependencies": {
        "@capacitor/cli": "^8.4.0",
        "@capacitor/core": "^8.4.0",
        "cors": "^2.8.5",
        "express": "^4.18.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^2.5.1",
        "jszip": "^3.10.1",
        "pinia": "^2.1.0",
        "sql.js": "^1.10.0",
        "vue": "^3.4.0",
        "vue-router": "^4.2.0"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "^5.0.0",
        "concurrently": "^8.0.0",
        "electron": "^28.0.0",
        "electron-builder": "^24.0.0",
        "sharp": "^0.35.1",
        "vite": "^5.0.0"
    },
    "build": {
        "appId": "com.bnotes.app",
        "productName": "BNotes",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "backend-node/**/*",
            "node_modules/**/*"
        ],
        "win": {
            "target": [
                {
                    "target": "portable",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "sign": false
        },
        "portable": {
            "artifactName": "${productName}-${version}-portable.${ext}"
        }
    }
}
