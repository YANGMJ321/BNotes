{
    "name": "bnotes-electron",
    "version": "1.0.0",
    "description": "BNotes Desktop Application",
    "main": "electron/main.js",
    "scripts": {
        "start": "electron .",
        "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
        "dev:frontend": "vite",
        "dev:backend": "php -S localhost:8000 -t . backend/api",
        "build:frontend": "vite build",
        "electron": "electron-builder"
    },
    "build": {
        "appId": "com.bnotes.app",
        "productName": "BNotes",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "backend/**/*",
            "data/**/*",
            "node_modules/**/*",
            "package.json"
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": ["x64"]
                }
            ]
        },
        "nsis": {
            "oneClick": false,
            "allowToChangeInstallationDirectory": true
        }
    },
    "devDependencies": {
        "concurrently": "^8.0.0"
    }
}
